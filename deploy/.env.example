# Chép tệp này thành `.env` rồi sửa, TRƯỚC khi chạy `docker compose up`:
#
#     cp .env.example .env
#
# `.env` đã nằm trong .gitignore và .dockerignore — nó chứa bí mật, không bao giờ
# được đưa vào kho mã hay vào image.

# ============================================================ BẮT BUỘC ĐỔI
# Khoá ký token đăng nhập. Ai biết khoá này thì tự tạo được token quản trị hợp lệ.
# Sinh khoá mới:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
FACEID_SECRET_KEY=doi-khoa-nay-di-dung-de-nguyen

# ============================================================ cơ sở dữ liệu
# Mặc định SQLite trong volume — chạy được ngay, không cần dịch vụ nào khác.
FACEID_DATABASE_URL=sqlite:////app/db/faceid.sqlite3

# Dùng PostgreSQL: bỏ chú thích ba dòng dưới, rồi chạy với --profile pg
# FACEID_DATABASE_URL=postgresql+psycopg://faceid:doi-mat-khau-nay@db:5432/faceid
# POSTGRES_USER=faceid
# POSTGRES_PASSWORD=doi-mat-khau-nay

# ============================================================ engine
# Ngưỡng chấp nhận một lần so khớp (độ tương đồng cosine, 0–1).
#   thấp hơn → dễ nhận ra người quen, nhưng dễ nhận nhầm người lạ
#   cao hơn  → an toàn hơn, nhưng hay bắt chụp lại
# 0.55 là điểm chọn từ đường cong TAR@FAR đo trên tập kiểm tra (xem báo cáo).
FACEID_MATCH_THRESHOLD=0.55
FACEID_MIN_CONFIDENCE=0.55

# Chống giả mạo Ở PHÍA MÁY CHỦ: để "none" và ĐỪNG đổi, trừ khi biết rõ đang làm gì.
#
# Máy chủ chỉ nhận MỘT tấm ảnh mỗi lần điểm danh, trong khi phương pháp hiệu quả
# duy nhất (phát hiện chớp mắt) cần cả chuỗi khung hình. Phương pháp phân tích kết
# cấu ảnh tuy chạy được trên một tấm ảnh nhưng đã đo là HỎNG trước tấn công thật:
#
#     mặt thật 0,426–0,995  ·  ảnh trên màn hình 1,000  ->  APCER 100 %, ACER 50–70 %
#
# Bật nó lên còn tệ hơn tắt: chặn oan người thật mà vẫn cho mọi đòn tấn công lọt.
# Việc chống giả mạo được thực thi tại máy kiosk, nơi có luồng video.
FACEID_LIVENESS_BACKEND=none

# Chỉ mục tra cứu: bruteforce | hnsw
#   Dưới ~5000 người thì bruteforce nhanh hơn và luôn chính xác tuyệt đối.
#   hnsw chỉ đáng đổi khi số người lớn hơn nhiều (đánh đổi một chút độ chính xác
#   lấy tốc độ tra cứu gần như không đổi theo số lượng).
FACEID_INDEX_BACKEND=bruteforce

# ============================================================ nghiệp vụ
# Cùng một người trong khoảng phút này chỉ ghi một bản ghi điểm danh.
FACEID_CHECKIN_COOLDOWN_MINUTES=5

# ============================================================ hệ thống
# Cổng duy nhất mở ra ngoài. Đổi ở đây là đổi cho toàn bộ hệ thống: hai tệp .bat
# và các bộ kiểm thử đều đọc lại giá trị này, không viết cứng ở nơi nào khác.
# Mặc định 8080 đã bỏ vì hay đụng với dự án khác trên cùng máy.
WEB_PORT=8090
TZ=Asia/Ho_Chi_Minh

# Chỉ cần khi có máy kiosk hoặc giao diện chạy ở tên miền khác với API.
# Đi qua nginx (cách mặc định) thì để trống.
FACEID_CORS_ORIGINS=
